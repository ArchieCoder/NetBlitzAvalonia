<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:NetBlitz.Desktop"
             x:Class="NetBlitz.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#07078D" /></FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter"/>
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.Window}"/>
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Ink}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14,9"/>
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.DeepBlue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{x:Static theme:NetBlitzTheme.DeepBlue}"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.HoverBlue}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{x:Static theme:NetBlitzTheme.HoverBlue}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.PressedBlue}"/><Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Yellow}"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.Disabled}"/>
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.DisabledText}"/>
      <Setter Property="BorderBrush" Value="{x:Static theme:NetBlitzTheme.Frame}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Yellow}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Yellow}"/>
    </Style>
    <Style Selector="Button.pool">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.LightSquare}"/>
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Ink}"/>
      <Setter Property="BorderBrush" Value="{x:Static theme:NetBlitzTheme.DarkSquare}"/>
    </Style>
    <Style Selector="Button.pool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.PoolHover}"/>
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Ink}"/>
    </Style>
    <Style Selector="Button.pool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.LightSquare}"/>
      <Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Muted}"/>
      <Setter Property="BorderBrush" Value="{x:Static theme:NetBlitzTheme.Frame}"/>
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{x:Static theme:NetBlitzTheme.Muted}"/></Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{x:Static theme:NetBlitzTheme.Surface}"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{x:Static theme:NetBlitzTheme.Frame}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="SelectionBrush" Value="{x:Static theme:NetBlitzTheme.PoolHover}"/>
      <Setter Property="SelectionForegroundBrush" Value="{x:Static theme:NetBlitzTheme.Ink}"/>
    </Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6"/></Style>
  </Application.Styles>
</Application>
